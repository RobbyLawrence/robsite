<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Home on Robby Lawrence</title><link>https://RobbyLawrence.vercel.app/</link><description>Recent content in Home on Robby Lawrence</description><generator>Hugo -- gohugo.io</generator><language>en-us</language><copyright>© 2026 Robby Lawrence</copyright><lastBuildDate>Mon, 13 Apr 2026 15:15:12 -0400</lastBuildDate><atom:link href="https://RobbyLawrence.vercel.app/index.xml" rel="self" type="application/rss+xml"/><item><title>Jigsaw Sudoku</title><link>https://RobbyLawrence.vercel.app/posts/jigsaw-sudoku/</link><pubDate>Mon, 13 Apr 2026 15:15:12 -0400</pubDate><guid>https://RobbyLawrence.vercel.app/posts/jigsaw-sudoku/</guid><description>&lt;h3 class="relative group"&gt;Lucas, the Sudoku Wizard
 &lt;div id="lucas-the-sudoku-wizard" class="anchor"&gt;&lt;/div&gt;
 
 &lt;span
 class="absolute top-0 w-6 transition-opacity opacity-0 -start-6 not-prose group-hover:opacity-100 select-none"&gt;
 &lt;a class="text-primary-300 dark:text-neutral-700 !no-underline" href="#lucas-the-sudoku-wizard" aria-label="Anchor"&gt;#&lt;/a&gt;
